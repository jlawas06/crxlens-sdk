{
  "name": "@crxlens/sdk",
  "version": "0.1.0",
  "description": "Observability SDK for Chrome Extensions — capture errors, breadcrumbs, and cross-context traces.",
  "keywords": [
    "chrome-extension",
    "observability",
    "error-tracking",
    "sentry",
    "tracing",
    "crxlens"
  ],
  "author": "CRXLens",
  "license": "MIT",
  "homepage": "https://crxlens.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/jlawas06/crxlens-sdk"
  },
  "files": [
    "dist"
  ],
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.37",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}